generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* ================================
   CATÁLOGOS BASE
================================ */

model CategoriaBase {
  id         Int     @id @default(autoincrement())
  tipoAnimal String
  nombre     String
  estado     Boolean @default(true)

  subpartes      SubparteBase[]
  categoriasLote CategoriaLote[]
}

model SubparteBase {
  id              Int     @id @default(autoincrement())
  idCategoriaBase Int
  nombre          String
  estado          Boolean @default(true)

  categoria     CategoriaBase @relation(fields: [idCategoriaBase], references: [id])
  subpartesLote SubparteLote[]
  productosSalidaComponentes ProductoSalidaComponente[]
}

/* ================================
   PRODUCTOS DE SALIDA (VENTA)
================================ */

model ProductoSalida {
  id     Int     @id @default(autoincrement())
  nombre String
  unidad String  // kg | unidad
  etiqueta String?
  activo Boolean @default(true)

  componentes            ProductoSalidaComponente[]
  componentesLote        ProductoSalidaComponenteLote[]
  componentesSubparte    ProductoSalidaComponenteSubparte[]
  componentesIndividual  ProductoSalidaComponenteIndividual[]
}

model ProductoSalidaComponente {
  id               Int @id @default(autoincrement())
  productoSalidaId Int
  subparteBaseId   Int

  productoSalida ProductoSalida @relation(fields: [productoSalidaId], references: [id])
  subparteBase   SubparteBase   @relation(fields: [subparteBaseId], references: [id])
  @@unique([productoSalidaId, subparteBaseId])
}

model ProductoSalidaComponenteLote {
  id               Int @id @default(autoincrement())
  productoSalidaId Int
  loteId           Int

  productoSalida ProductoSalida @relation(fields: [productoSalidaId], references: [id])
  lote           Lote           @relation(fields: [loteId], references: [id])
  @@unique([productoSalidaId, loteId])
}

model ProductoSalidaComponenteSubparte {
  id               Int @id @default(autoincrement())
  productoSalidaId Int
  subparteLoteId   Int

  productoSalida ProductoSalida @relation(fields: [productoSalidaId], references: [id])
  subparteLote   SubparteLote   @relation(fields: [subparteLoteId], references: [id])
  @@unique([productoSalidaId, subparteLoteId])
}

model ProductoSalidaComponenteIndividual {
  id               Int @id @default(autoincrement())
  productoSalidaId Int
  loteIndividualId Int

  productoSalida   ProductoSalida @relation(fields: [productoSalidaId], references: [id])
  loteIndividual   LoteIndividual @relation(fields: [loteIndividualId], references: [idLote])
  @@unique([productoSalidaId, loteIndividualId])
}

/* ================================
   INGRESO DE INVENTARIO
================================ */

model Procedencia {
  id     Int    @id @default(autoincrement())
  nombre String

  lotes           Lote[]
  lotesIndividual LoteIndividual[]
}

model Proveedor {
  id           Int      @id @default(autoincrement())
  nombre       String
  tipoAnimal   String
  telefono     String?
  ciudad       String?
  tipoProveedor String
  direccion    String?
  cedulaNit    String
  correo       String?
  observacion  String?

  lotes Lote[]
}

/* ================================
   LOTE PRINCIPAL
================================ */

model Lote {
  id            Int      @id @default(autoincrement())
  tipoIngreso   String
  tipoAnimal    String
  procedenciaId Int?
  procedencia   Procedencia? @relation(fields: [procedenciaId], references: [id])
  guia          Boolean?
  fotoGuia      String?
  pesoKgInicial     Float
  pesoKgActual      Float
  pesoKgLimpio      Float?   // Nuevo campo: peso limpio en kg
  pesoArrobaLimpio  Float?   // Nuevo campo: peso limpio en arrobas
  precioKg          Float?
  precioArroba      Float?
  precioTotal       Float
  limpio            Boolean?
  sexo              String?
  clasificacion     String?
  dientes           Int?
  despostado        Boolean  @default(false)
  fechaIngreso      DateTime @default(now())
  idUsuario     Int

  proveedorId Int
  proveedor   Proveedor @relation(fields: [proveedorId], references: [id])

  categoriasLote CategoriaLote[]
  subpartesLote  SubparteLote[]
  loteIndividual LoteIndividual?
  productosSalida ProductoSalidaComponenteLote[]

  alertasReglas AlertaRegla[]
}

/* ================================
   DESPOSTE
================================ */

model CategoriaLote {
  id              Int      @id @default(autoincrement())
  idLote          Int
  idCategoriaBase Int
  pesoCategoriaKg Float
  fechaRegistro   DateTime @default(now())

  lote          Lote          @relation(fields: [idLote], references: [id])
  categoriaBase CategoriaBase @relation(fields: [idCategoriaBase], references: [id])

  subpartes SubparteLote[]
  alertasReglas AlertaRegla[]
}

model SubparteLote {
  id              Int      @id @default(autoincrement())
  idLote          Int
  idCategoriaLote Int
  idSubparteBase  Int
  pesoSubparteKg  Float
  fechaPesado     DateTime @default(now())

  lote          Lote          @relation(fields: [idLote], references: [id])
  categoriaLote CategoriaLote @relation(fields: [idCategoriaLote], references: [id])
  subparteBase  SubparteBase  @relation(fields: [idSubparteBase], references: [id])

  movimientos MovimientoInventario[]
  productosSalida ProductoSalidaComponenteSubparte[]
  alertasReglas AlertaRegla[]
}

/* ================================
   COMPRAS INDIVIDUALES
================================ */

model ProductoBase {
  id        Int     @id @default(autoincrement())
  nombre    String
  categoria String?
  estado    Boolean @default(true)

  lotesIndividuales LoteIndividual[]
  alertasReglas     AlertaRegla[]
}

model LoteIndividual {
  idLote         Int @id
  idProductoBase Int
  pesoKg         Float
  precioKg       Float
  precioTotal    Float
  unidades       Int?
  fechaRegistro  DateTime @default(now())

  procedenciaId Int?
  procedencia   Procedencia? @relation(fields: [procedenciaId], references: [id])

  lote     Lote         @relation(fields: [idLote], references: [id])
  producto ProductoBase @relation(fields: [idProductoBase], references: [id])
  productosSalida ProductoSalidaComponenteIndividual[]
  alertasReglas AlertaRegla[]
}

/* ================================
   MOVIMIENTOS (SALIDAS)
================================ */

model MovimientoInventario {
  id             Int      @id @default(autoincrement())
  tipo           String   // VENTA | MERMA | AJUSTE
  referenciaId   Int?
  subparteLoteId Int
  subparteBaseId Int
  peso           Float
  fecha          DateTime @default(now())

  subparteLote SubparteLote @relation(fields: [subparteLoteId], references: [id])
}

/* ================================
   ALERTAS
================================ */

model Alerta {
  id        Int      @id @default(autoincrement())
  tipo      String   // INFO | WARNING | CRITICO
  mensaje   String
  fecha     DateTime @default(now())
  leida     Boolean  @default(false)
}

model AlertaRegla {
  id                 Int      @id @default(autoincrement())

  loteId             Int?
  categoriaLoteId    Int?
  subparteLoteId     Int?
  loteIndividualId   Int?
  productoId         Int?

  tipo               String   // MINIMO_KG | PORCENTAJE | etc.
  valor              Float

  activa             Boolean  @default(true)
  fechaCreada        DateTime @default(now())

  lote               Lote?            @relation(fields: [loteId], references: [id])
  categoriaLote      CategoriaLote?   @relation(fields: [categoriaLoteId], references: [id])
  subparteLote       SubparteLote?    @relation(fields: [subparteLoteId], references: [id])
  loteIndividual     LoteIndividual?  @relation(fields: [loteIndividualId], references: [idLote])
  producto           ProductoBase?    @relation(fields: [productoId], references: [id])
}
