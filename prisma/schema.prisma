generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================================
// TABLAS BASE (CATÁLOGOS)
// ================================

// Categorías generales del animal (brazo, pierna, cogote, etc.)
model CategoriaBase {
  id         Int     @id @default(autoincrement())
  tipoAnimal String // res | cerdo | pollo | pescado | individual
  nombre     String
  estado     Boolean @default(true)

  subpartes      SubparteBase[]
  categoriasLote CategoriaLote[]
}

// Subpartes “maestras” del desposte (murillo, bola, etc.)
model SubparteBase {
  id              Int     @id @default(autoincrement())
  idCategoriaBase Int
  nombre          String
  estado          Boolean @default(true)

  categoria CategoriaBase @relation(fields: [idCategoriaBase], references: [id])

  subpartesLote SubparteLote[]
}
 
// Productos que existen aunque no sean desposte (Ubre, pescado entero, etc.)
model ProductoBase {
  id        Int     @id @default(autoincrement())
  nombre    String
  categoria String? // vísceras, pescado, pollo, etc.
  estado    Boolean @default(true)

  lotesIndividuales LoteIndividual[]
}

// ================================
// INGRESOS DE INVENTARIO
// ================================


// Proveedores
model Proveedor {
  id           Int      @id @default(autoincrement())
  nombre       String
  tipoAnimal   String   // res | cerdo | pollo | pescado | producto_individual
  telefono     String?
  ciudad       String?
  tipoProveedor String   // natural | juridica
  direccion    String?
  cedulaNit    String
  correo       String?
  observacion  String?

  lotes        Lote[]   // Relación 1 - N
}


// Lote principal: res, cerdo o compra individual
model Lote {
  id            Int      @id @default(autoincrement())
  tipoIngreso   String
  tipoAnimal    String
  procedencia   String?
  guia          Boolean?
  fotoGuia      String?
  pesoKgInicial Float
  pesoKgActual  Float
  precioKg      Float?
  precioArroba  Float?
  precioTotal   Float
  limpio        Boolean?
  sexo          String?
  clasificacion String?
  dientes       Int?
  fechaIngreso  DateTime @default(now())
  idUsuario     Int

  // 🔗 RELACIÓN CON PROVEEDOR
  proveedorId   Int
  proveedor     Proveedor @relation(fields: [proveedorId], references: [id])

  categoriasLote CategoriaLote[]
  subpartesLote  SubparteLote[]
  loteIndividual LoteIndividual?
}


// ================================
// DESPOSTE POR LOTE
// ================================

// Categorías del desposte asociadas a un lote (ej: brazo, pierna)
model CategoriaLote {
  id              Int      @id @default(autoincrement())
  idLote          Int
  idCategoriaBase Int
  pesoCategoriaKg Float
  fechaRegistro   DateTime @default(now())

  lote          Lote          @relation(fields: [idLote], references: [id])
  categoriaBase CategoriaBase @relation(fields: [idCategoriaBase], references: [id])

  subpartes SubparteLote[]
}

// Subpartes asociadas a una categoría del desposte (ej: murillo, bola)
model SubparteLote {
  id              Int      @id @default(autoincrement())
  idLote          Int
  idCategoriaLote Int
  idSubparteBase  Int
  pesoSubparteKg  Float
  fechaPesado     DateTime @default(now())

  lote          Lote          @relation(fields: [idLote], references: [id])
  categoriaLote CategoriaLote @relation(fields: [idCategoriaLote], references: [id])
  subparteBase  SubparteBase  @relation(fields: [idSubparteBase], references: [id])
}

// ================================
// COMPRAS INDIVIDUALES
// (ej: ubre, bofe, pescado entero, etc.)
// ================================

model LoteIndividual {
  idLote         Int      @id
  idProductoBase Int
  pesoKg         Float
  precioKg       Float
  precioTotal    Float
  fechaRegistro  DateTime @default(now())

  lote     Lote         @relation(fields: [idLote], references: [id])
  producto ProductoBase @relation(fields: [idProductoBase], references: [id])
}


