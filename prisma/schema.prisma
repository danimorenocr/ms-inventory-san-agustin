generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["inventory"]
}

model CategoriaBase {
  id         Int     @id @default(autoincrement())
  tipoAnimal String
  nombre     String
  estado     Boolean @default(true)

  subpartes      SubparteBase[]
  categoriasLote CategoriaLote[]

  @@schema("inventory")
}

model SubparteBase {
  id                Int     @id @default(autoincrement())
  idCategoriaBase   Int
  nombre            String
  estado            Boolean @default(true)
  reservaCombosKg   Float   @default(0)
  consumidoCombosKg Float   @default(0)

  categoria                  CategoriaBase              @relation(fields: [idCategoriaBase], references: [id])
  subpartesLote              SubparteLote[]
  productosSalidaComponentes ProductoSalidaComponente[]

  @@schema("inventory")
}

model ProductoSalida {
  id       Int     @id @default(autoincrement())
  nombre   String
  unidad   String
  precio   Float?
  etiqueta String?
  activo   Boolean @default(true)

  componentes           ProductoSalidaComponente[]
  componentesIndividual ProductoSalidaComponenteIndividual[]

  @@schema("inventory")
}

model ProductoSalidaComponente {
  id               Int   @id @default(autoincrement())
  productoSalidaId Int
  subparteBaseId   Int
  factorAsignacion Float @default(0)

  productoSalida ProductoSalida @relation(fields: [productoSalidaId], references: [id], onDelete: Cascade)
  subparteBase   SubparteBase   @relation(fields: [subparteBaseId], references: [id])

  @@unique([productoSalidaId, subparteBaseId])
  @@schema("inventory")
}

model ProductoSalidaComponenteIndividual {
  id               Int   @id @default(autoincrement())
  productoSalidaId Int
  productoBaseId   Int
  factorAsignacion Float @default(0)

  productoSalida ProductoSalida @relation(fields: [productoSalidaId], references: [id], onDelete: Cascade)
  productoBase   ProductoBase   @relation(fields: [productoBaseId], references: [id])

  @@unique([productoSalidaId, productoBaseId])
  @@schema("inventory")
}

model Procedencia {
  id     Int    @id @default(autoincrement())
  nombre String

  lotes           Lote[]
  lotesIndividual LoteIndividual[]

  @@schema("inventory")
}

model Proveedor {
  id            Int     @id @default(autoincrement())
  nombre        String
  tipoAnimal    String
  telefono      String?
  ciudad        String?
  tipoProveedor String
  direccion     String?
  cedulaNit     String
  correo        String?
  observacion   String?

  lotes Lote[]

  @@schema("inventory")
}

model Lote {
  id               Int      @id @default(autoincrement())
  tipoIngreso      String
  tipoAnimal       String
  procedenciaId    Int?
  guia             Boolean?
  fotoGuia         String?
  pesoKgInicial    Float
  pesoKgActual     Float
  pesoKgLimpio     Float?
  pesoArrobaLimpio Float?
  precioKg         Float?
  precioArroba     Float?
  precioTotal      Float
  limpio           Boolean?
  sexo             String?
  clasificacion    String?
  dientes          Int?
  despostado       Boolean  @default(false)
  fechaIngreso     DateTime @default(now())
  idUsuario        Int
  proveedorId      Int

  procedencia    Procedencia?    @relation(fields: [procedenciaId], references: [id])
  proveedor      Proveedor       @relation(fields: [proveedorId], references: [id])
  categoriasLote CategoriaLote[]
  subpartesLote  SubparteLote[]
  loteIndividual LoteIndividual?
  alertasReglas  AlertaRegla[]

  @@schema("inventory")
}

model CategoriaLote {
  id              Int      @id @default(autoincrement())
  idLote          Int
  idCategoriaBase Int
  pesoCategoriaKg Float
  fechaRegistro   DateTime @default(now())

  lote          Lote          @relation(fields: [idLote], references: [id])
  categoriaBase CategoriaBase @relation(fields: [idCategoriaBase], references: [id])
  subpartes     SubparteLote[]
  alertasReglas AlertaRegla[]

  @@schema("inventory")
}

model SubparteLote {
  id              Int      @id @default(autoincrement())
  idLote          Int
  idCategoriaLote Int
  idSubparteBase  Int
  pesoSubparteKg  Float
  fechaPesado     DateTime @default(now())

  lote          Lote                   @relation(fields: [idLote], references: [id])
  categoriaLote CategoriaLote          @relation(fields: [idCategoriaLote], references: [id])
  subparteBase  SubparteBase           @relation(fields: [idSubparteBase], references: [id])
  movimientos   MovimientoInventario[]
  alertasReglas AlertaRegla[]

  @@schema("inventory")
}

model ProductoBase {
  id                Int     @id @default(autoincrement())
  nombre            String
  categoria         String?
  estado            Boolean @default(true)
  reservaCombosKg   Float   @default(0)
  consumidoCombosKg Float   @default(0)

  lotesIndividuales          LoteIndividual[]
  alertasReglas              AlertaRegla[]
  productosSalidaComponentes ProductoSalidaComponenteIndividual[]

  @@schema("inventory")
}

model LoteIndividual {
  idLote         Int      @id
  idProductoBase Int
  pesoKg         Float
  precioKg       Float
  precioTotal    Float
  unidades       Int?
  fechaRegistro  DateTime @default(now())
  procedenciaId  Int?

  procedencia   Procedencia?  @relation(fields: [procedenciaId], references: [id])
  lote          Lote          @relation(fields: [idLote], references: [id])
  producto      ProductoBase  @relation(fields: [idProductoBase], references: [id])
  alertasReglas AlertaRegla[]

  @@schema("inventory")
}

model MovimientoInventario {
  id             Int      @id @default(autoincrement())
  tipo           String
  referenciaId   Int?
  subparteLoteId Int
  subparteBaseId Int
  peso           Float
  fecha          DateTime @default(now())

  subparteLote SubparteLote @relation(fields: [subparteLoteId], references: [id])

  @@schema("inventory")
}

model Alerta {
  id      Int      @id @default(autoincrement())
  tipo    String
  mensaje String
  fecha   DateTime @default(now())
  leida   Boolean  @default(false)

  @@schema("inventory")
}

model AlertaRegla {
  id               Int      @id @default(autoincrement())
  loteId           Int?
  categoriaLoteId  Int?
  subparteLoteId   Int?
  loteIndividualId Int?
  productoId       Int?
  tipo             String
  valor            Float
  activa           Boolean  @default(true)
  fechaCreada      DateTime @default(now())

  lote           Lote?           @relation(fields: [loteId], references: [id])
  categoriaLote  CategoriaLote?  @relation(fields: [categoriaLoteId], references: [id])
  subparteLote   SubparteLote?   @relation(fields: [subparteLoteId], references: [id])
  loteIndividual LoteIndividual? @relation(fields: [loteIndividualId], references: [idLote])
  producto       ProductoBase?   @relation(fields: [productoId], references: [id])

  @@schema("inventory")
}