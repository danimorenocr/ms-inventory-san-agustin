generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client-local"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_LOCAL_URL")
}

/* ================================
   CATÁLOGOS BASE
================================ */

model CategoriaBase {
  id         Int     @id @default(autoincrement())
  tipoAnimal String
  nombre     String
  estado     Boolean @default(true)

  subpartes      SubparteBase[]
  categoriasLote CategoriaLote[]
}

model SubparteBase {
  id              Int     @id @default(autoincrement())
  idCategoriaBase Int
  nombre          String
  estado          Boolean @default(true)
  reservaCombosKg Float   @default(0)
  consumidoCombosKg Float @default(0)

  categoria     CategoriaBase @relation(fields: [idCategoriaBase], references: [id], onDelete: Cascade)
  subpartesLote SubparteLote[]
  productosSalidaComponentes ProductoSalidaComponente[]
  alertasReglas AlertaRegla[]
}

/* ================================
   PRODUCTOS DE SALIDA (VENTA)
================================ */

model ProductoSalida {
  id     Int     @id @default(autoincrement())
  nombre String
  unidad String  // kg | unidad
  precio Float?  // Precio unitario
  etiqueta String?
  activo Boolean @default(true)

  componentes            ProductoSalidaComponente[]
  componentesIndividual  ProductoSalidaComponenteIndividual[]
}

model ProductoSalidaComponente {
  id               Int @id @default(autoincrement())
  productoSalidaId Int
  subparteBaseId   Int
  factorAsignacion Float @default(0)

  productoSalida ProductoSalida @relation(fields: [productoSalidaId], references: [id], onDelete: Cascade)
  subparteBase   SubparteBase   @relation(fields: [subparteBaseId], references: [id], onDelete: Cascade)
  @@unique([productoSalidaId, subparteBaseId])
}


model ProductoSalidaComponenteIndividual {
  id               Int @id @default(autoincrement())
  productoSalidaId Int
  productoBaseId   Int
  factorAsignacion Float @default(0)

  productoSalida   ProductoSalida @relation(fields: [productoSalidaId], references: [id], onDelete: Cascade)
  productoBase     ProductoBase   @relation(fields: [productoBaseId], references: [id], onDelete: Cascade)
  @@unique([productoSalidaId, productoBaseId])
}

/* ================================
   INGRESO DE INVENTARIO
================================ */

model Procedencia {
  id     Int    @id @default(autoincrement())
  nombre String

  lotes           Lote[]
  lotesIndividual LoteIndividual[]
}

model Proveedor {
  id           Int      @id @default(autoincrement())
  nombre       String
  tipoAnimal   String
  telefono     String?
  ciudad       String?
  tipoProveedor String
  direccion    String?
  cedulaNit    String
  correo       String?
  observacion  String?

  lotes Lote[]
}

/* ================================
   LOTE PRINCIPAL
================================ */

model Lote {
  id            Int      @id @default(autoincrement())
  tipoIngreso   String
  tipoAnimal    String
  procedenciaId Int?
  procedencia   Procedencia? @relation(fields: [procedenciaId], references: [id], onDelete: SetNull)
  guia          Boolean?
  fotoGuia      String?
  pesoKgInicial     Float
  pesoKgActual      Float
  pesoKgLimpio      Float?   // Nuevo campo: peso limpio en kg
  pesoArrobaLimpio  Float?   // Nuevo campo: peso limpio en arrobas
  precioKg          Float?
  precioArroba      Float?
  precioTotal       Float
  limpio            Boolean?
  sexo              String?
  clasificacion     String?
  dientes           Int?
  despostado        Boolean  @default(false)
  fechaIngreso      DateTime @default(now())
  idUsuario     Int

  proveedorId Int
  proveedor   Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Cascade)

  categoriasLote CategoriaLote[]
  subpartesLote  SubparteLote[]
  loteIndividual LoteIndividual?
  registroMerma  RegistroMerma?


  alertasReglas AlertaRegla[]
}

/* ================================
   DESPOSTE
================================ */

model CategoriaLote {
  id              Int      @id @default(autoincrement())
  idLote          Int
  idCategoriaBase Int
  pesoCategoriaKg Float
  unidades        Int?
  fechaRegistro   DateTime @default(now())

  lote          Lote          @relation(fields: [idLote], references: [id], onDelete: Cascade)
  categoriaBase CategoriaBase @relation(fields: [idCategoriaBase], references: [id], onDelete: Cascade)

  subpartes SubparteLote[]
  alertasReglas AlertaRegla[]
}

model SubparteLote {
  id              Int      @id @default(autoincrement())
  idLote          Int
  idCategoriaLote Int
  idSubparteBase  Int
  pesoSubparteKg  Float
  unidades        Int?
  fechaPesado     DateTime @default(now())

  lote          Lote          @relation(fields: [idLote], references: [id], onDelete: Cascade)
  categoriaLote CategoriaLote @relation(fields: [idCategoriaLote], references: [id], onDelete: Cascade)
  subparteBase  SubparteBase  @relation(fields: [idSubparteBase], references: [id], onDelete: Cascade)

  movimientos MovimientoInventario[]

  alertasReglas AlertaRegla[]
}

/* ================================
   COMPRAS INDIVIDUALES
================================ */

model ProductoBase {
  id        Int     @id @default(autoincrement())
  nombre    String
  categoria String?
  estado    Boolean @default(true)
  reservaCombosKg Float   @default(0)
  consumidoCombosKg Float @default(0)

  lotesIndividuales LoteIndividual[]
  alertasReglas     AlertaRegla[]
  productosSalidaComponentes ProductoSalidaComponenteIndividual[]
}

model LoteIndividual {
  idLote         Int @id
  idProductoBase Int
  pesoKg         Float
  precioKg       Float
  precioTotal    Float
  unidades       Int?
  fechaRegistro  DateTime @default(now())

  procedenciaId Int?
  procedencia   Procedencia? @relation(fields: [procedenciaId], references: [id], onDelete: SetNull)

  lote     Lote         @relation(fields: [idLote], references: [id], onDelete: Cascade)
  producto ProductoBase @relation(fields: [idProductoBase], references: [id], onDelete: Cascade)
  // Removed relation to ProductoSalidaComponenteIndividual
  alertasReglas AlertaRegla[]
}

/* ================================
   MOVIMIENTOS (SALIDAS)
================================ */

model MovimientoInventario {
  id             Int      @id @default(autoincrement())
  tipo           String   // VENTA | MERMA | AJUSTE
  referenciaId   Int?
  subparteLoteId Int
  subparteBaseId Int
  peso           Float
  fecha          DateTime @default(now())

  subparteLote SubparteLote @relation(fields: [subparteLoteId], references: [id], onDelete: Cascade)
}

/* ================================
   ALERTAS
================================ */

model Alerta {
  id        Int      @id @default(autoincrement())
  tipo      String   // INFO | WARNING | CRITICO
  mensaje   String
  fecha     DateTime @default(now())
  leida     Boolean  @default(false)
}

model AlertaRegla {
  id                 Int      @id @default(autoincrement())

  loteId             Int?
  categoriaLoteId    Int?
  subparteLoteId     Int?
  loteIndividualId   Int?
  productoId         Int?
  subparteBaseId     Int?

  tipo               String   // MINIMO_KG | PORCENTAJE | etc.
  valor              Float

  activa             Boolean  @default(true)
  fechaCreada        DateTime @default(now())

  lote               Lote?            @relation(fields: [loteId], references: [id], onDelete: Cascade)
  categoriaLote      CategoriaLote?   @relation(fields: [categoriaLoteId], references: [id], onDelete: Cascade)
  subparteLote       SubparteLote?    @relation(fields: [subparteLoteId], references: [id], onDelete: Cascade)
  loteIndividual     LoteIndividual?  @relation(fields: [loteIndividualId], references: [idLote], onDelete: Cascade)
  producto           ProductoBase?    @relation(fields: [productoId], references: [id], onDelete: Cascade)
  subparteBase       SubparteBase?    @relation(fields: [subparteBaseId], references: [id], onDelete: Cascade)
}

/* ================================
   SYNC QUEUE (OFFLINE-FIRST)
================================ */

model SyncQueue {
  id        Int      @id @default(autoincrement())
  entity    String   // ej: 'MovimientoInventario', 'Venta'
  action    String   // ej: 'CREATE', 'UPDATE', 'DELETE'
  payload   String   // JSON con los datos a sincronizar
  createdAt DateTime @default(now())
  synced    Boolean  @default(false)
  syncedAt  DateTime?
}

model RegistroMerma {
  id                     Int      @id @default(autoincrement())
  idLote                 Int      @unique
  
  // Pesos totales
  pesoTotalLoteKg        Float    // Peso total del lote
  pesoTotalCategoriasKg  Float    // Suma de todas las categorías
  pesoTotalSubpartesKg   Float    // Suma de todas las subpartes
  
  // Porcentajes de merma
  porcentajeMermaLote      Float  // % merma entre peso inicial y total categorías
  porcentajeMermaCategoria Float  // % merma entre total categorías y total subpartes
  porcentajeMermaSubparte  Float  // % merma acumulada total
  
  fechaRegistro          DateTime @default(now())
  
  lote                   Lote     @relation(fields: [idLote], references: [id], onDelete: Cascade)
}
